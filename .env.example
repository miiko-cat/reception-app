# --- Django ---
SECRET_KEY=（上で生成した値を貼り付け）
DEBUG=False
ALLOWED_HOSTS=<本番IP>

# --- PostgreSQL ---
POSTGRES_DB=reception
POSTGRES_USER=postgres
POSTGRES_PASSWORD=（強力なパスワードに変更）
DATABASE_URL=postgres://postgres:（上と同じパスワード）@db:5432/reception

# --- HTTPS ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://<本番IP>
